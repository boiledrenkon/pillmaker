{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun-types"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", "register-commands.ts", "preflight.ts"]
}
