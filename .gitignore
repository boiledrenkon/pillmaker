# ── secrets — NEVER commit ───────────────────────────────────────────────────
.env

# ── dependencies / virtualenvs (reinstalled per host / built in the image) ───
**/node_modules
.venv
.venv-img

# ── runtime state + logs (regenerated per host; never source) ────────────────
data
*.db
*.db-shm
*.db-wal
discord/worker.log

# ── generated output ─────────────────────────────────────────────────────────
# Images stay local (delivered via Discord; ~300MB and regenerable). The final
# ACCEPTED prompt per concept IS source — it's the reference record of what
# compose actually produces from a brief — so outputs/<slug>/<slug>.txt is
# tracked. Rejects under outputs/<slug>/fail/ stay ignored.
outputs/**
!outputs/*/
!outputs/*/*.txt

# ── python / OS cruft ────────────────────────────────────────────────────────
**/__pycache__
.DS_Store
**/.DS_Store
