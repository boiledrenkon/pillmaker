# Worker configuration. Copy to `.env` and fill in — or let `./setup.sh` write it.
# `.env` is gitignored; never commit real keys.

# ── Agents: prompt compose + QC judges (Claude Code) ────────────────────────
# Pick ONE auth path (leave the others blank):
#  • Laptop where Claude Code is already logged in → leave BOTH blank.
#  • VPS on your Max/Pro subscription → run `claude setup-token` on your Mac and
#    paste the token here (headless, no browser login, usage stays on your plan).
#  • Bill the API directly → set ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ── Image backend: only needed if BACKEND is not "manual" ────────────────────
# Fill in only the one matching this worker's BACKEND.
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
# OpenAI image model + quality (gpt-image-2 = best text; medium/high cost tiers).
OPENAI_IMAGE_MODEL=gpt-image-2  # gpt-image-1 | gpt-image-1.5 | gpt-image-2 | chatgpt-image-latest(needs org verify)
IMG_QUALITY=high                # low | medium | high | auto
IMG_N=1                         # candidates per attempt, best-of-n (openai only; n× image cost per attempt)

# ── Worker identity / control plane ─────────────────────────────────────────
WORKER_NAME=manual-1
BACKEND=manual                 # manual | openai | gemini | replicate
PROMPT_QC=both                 # off | auto | human | both
IMAGE_QC=both                  # off | auto | human | both
MAX_ATTEMPTS=3
SMITHERS_PORT=7331             # base port; each run serves on basePort+N
SMITHERS_BEARER_TOKEN=         # shared secret for the control-plane API (optional on localhost)
POLL_MS=3000                   # how often the bridge checks each run for gates
STALL_MIN=8                    # warn if a running (non-gated) run goes quiet this long

# ── Model + speed knobs (optional; sensible defaults) ───────────────────────
COMPOSE_FIRST_MODEL=claudeOpus # first prompt compose = quality
COMPOSE_MODEL=claudeSonnet     # compose revisions = speed
JUDGE_MODEL=claudeSonnet       # QC judges
TOOL_MODEL=claudeSonnet        # mechanical tool tasks (run generator cmd, finalize files)
EXPAND_MODEL=claude-sonnet-4-6 # request-intake auto-expansion (bot-side claude -p)
DIRECTIONS=3                   # pre-run artwork direction pitches (0 = off; skipped if brief sets artwork)

# ── Discord bridge ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=                # application (client) ID — for slash-command registration
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=         # REQUIRED — only this role may use admin cmds / approvals; bot won't start without it
DISCORD_STATUS_CHANNEL_ID=
DISCORD_QC_CHANNEL_ID=
DISCORD_OUTPUTS_CHANNEL_ID=

# ── Request-intake flow (optional; lets outsiders submit ideas you approve) ──
# Set these only if you want outsiders to submit via /request.
DISCORD_REQUESTS_CHANNEL_ID=   # public: where outsiders run /request
DISCORD_INTAKE_CHANNEL_ID=     # admin-only: the approve/reject queue

# ── Container only ──────────────────────────────────────────────────────────
# BOT_DB=/app/data/state.db    # set by compose to persist thread↔run mapping
# PROJECT_ROOT=/app            # repo root inside the container
